generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  OWNER
  ADMIN
}

enum TransactionType {
  BUY
  RENT
  STAY
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  LAND
  COMMERCIAL
  OFFICE
}

enum ListingStatus {
  DRAFT
  // Submitted by an owner and waiting for an administrator decision. Never
  // public: only DRAFT and REJECTED sit alongside it outside the public set.
  PENDING_REVIEW
  AVAILABLE
  RESERVED
  SOLD
  RENTED
  REJECTED
  ARCHIVED
}

enum Currency {
  USD
  EUR
  SYP
}

enum Governorate {
  DAMASCUS
  RIF_DIMASHQ
  ALEPPO
  RIF_ALEPPO
  LATAKIA
  HOMS
  HAMA
  IDLIB
  TARTUS
  DARAA
  AS_SUWAYDA
  RAQQA
  AL_HASAKAH
  DEIR_EZ_ZOR
  QUNEITRA
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  name         String
  // Self-service contact details. Both are nullable: every account created
  // before this column existed, and every Google sign-up, has neither.
  phone        String?
  whatsapp     String?
  passwordHash String?
  // Records how the account was first created. Kept as free text rather than an
  // enum so adding a provider never needs a database migration.
  provider     String        @default("PASSWORD")
  googleSub    String?       @unique @map("google_sub")
  isActive     Boolean       @default(true)
  role         UserRole      @default(USER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  properties   Property[]
  sessions     AuthSession[]
  office       Office?

  // "User_email_lower_key", a unique index over lower("email"), also guards
  // this column. Prisma Schema cannot express an index over an expression, so
  // it lives in migration 20260809120000_add_email_lower_unique_index only.
  // Future migrations must not drop it: sign-in normalises the address to
  // lowercase, so a case-variant duplicate would be unreachable forever.
  @@index([role])
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Property {
  id               String          @id @default(uuid()) @db.Uuid
  slug             String          @unique
  ownerId          String          @db.Uuid
  titleEn          String
  titleAr          String
  titleDe          String
  // Turkish arrived after the other three, so its columns are nullable: every
  // listing written before automatic translation has none, and the reader falls
  // back to the Arabic source rather than showing an empty card.
  titleTr          String?
  descriptionEn    String?         @db.Text
  descriptionAr    String?         @db.Text
  descriptionDe    String?         @db.Text
  descriptionTr    String?         @db.Text
  transaction      TransactionType
  propertyType     PropertyType
  status           ListingStatus   @default(DRAFT)
  // Set by an administrator when a submission is rejected, and cleared the
  // moment the owner resubmits or the listing is approved.
  rejectionReason  String?         @db.Text
  price            Decimal         @db.Decimal(14, 2)
  currency         Currency
  governorate      Governorate
  city             String
  district         String?
  neighborhood     String?
  address          String?
  bedrooms         Int?
  bathrooms        Int?
  area             Decimal         @db.Decimal(10, 2)
  latitude         Decimal?        @db.Decimal(9, 6)
  longitude        Decimal?        @db.Decimal(10, 6)
  // Optional seller contact number used to open a WhatsApp chat from the
  // listing. Stored as submitted (digits, spaces, optional leading +) so the
  // owner recognises their own number; consumers strip separators themselves.
  whatsapp         String?
  featured         Boolean         @default(false)
  videoUrl         String?
  videoStoragePath String?         @unique
  videoMimeType    String?
  videoSizeBytes   BigInt?
  // A listing may be published under an agency office. Optional and severed
  // rather than cascaded on delete: closing an office must never take the
  // listings with it.
  officeId         String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  owner            User            @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  office           Office?         @relation(fields: [officeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  images           PropertyImage[]

  @@index([officeId])
  // Serves the office profile page — one office's published listings, newest
  // first — and the per-office count on the office list. @@index([officeId])
  // stays: it is what backs the foreign key.
  @@index([officeId, status, createdAt])
  @@index([ownerId])
  @@index([ownerId, updatedAt])
  @@index([status, createdAt])
  @@index([status, featured])
  @@index([transaction, propertyType, governorate])
  @@index([governorate, city, district])
  @@index([price])
  @@index([createdAt])
}

model Office {
  // A cuid rather than a uuid: an office identifier is public and appears in
  // shareable URLs, so a shorter, URL-safe token is preferred here. Every other
  // model keeps its uuid primary key, which is why `Property.officeId` is TEXT.
  id            String      @id @default(cuid())
  // Unique, so an owner can hold at most one office. The create path relies on
  // this constraint rather than a read-then-write check, which would race.
  ownerId       String      @unique @db.Uuid
  nameAr        String
  nameEn        String
  nameDe        String
  descriptionAr String?     @db.Text
  descriptionEn String?     @db.Text
  descriptionDe String?     @db.Text
  governorate   Governorate
  city          String?
  phone         String?
  whatsapp      String?
  logoUrl       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  owner         User        @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  properties    Property[]

  @@index([governorate])
  @@index([createdAt])
}

model PropertyImage {
  id          String   @id @default(uuid()) @db.Uuid
  propertyId  String   @db.Uuid
  url         String
  storagePath String?  @unique
  mimeType    String?
  sizeBytes   Int?
  width       Int?
  height      Int?
  altEn       String?
  altAr       String?
  altDe       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([propertyId, sortOrder])
  @@index([propertyId])
}
